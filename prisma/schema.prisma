// Schema de Dolka Star.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GameSession {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  ip         String?
  userAgent  String?
  playerId   String?
  scores     Score[]

  @@index([ip, startedAt])
}

model Score {
  id         String      @id @default(cuid())
  sessionId  String
  session    GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId   String
  score      Int
  playerName String
  whatsapp   String?
  weekStart  DateTime    @db.Timestamptz(3)
  verified   Boolean     @default(false)
  local      String      @default("andalgala")
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([playerId, weekStart, local])
  @@index([local, weekStart, score(sort: Desc)])
  @@index([playerId])
}

model Pedido {
  id         Int      @id @default(autoincrement())
  /// Número de comanda que se canta en el local: arranca en 1 cada turno.
  /// El `id` sigue siendo la clave real; esto es lo que ve la gente.
  numero     Int?
  /// El turno al que pertenece, como "2026-10-01" (la fecha en que arrancó).
  /// Dos pedidos del mismo turno y local no pueden tener el mismo número.
  turno      String?
  local      String
  cliente    String
  telefono   String?
  modalidad  String
  direccion  String?
  items      Json
  total      Int
  metodoPago String   @default("efectivo")
  estado     String   @default("pendiente")
  creadoEn   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([local, turno, numero])
}